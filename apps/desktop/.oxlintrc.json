{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "overrides": [
    {
      "files": ["src/renderer/src/**/*.{ts,tsx}"],
      "rules": {
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "node:*",
              "electron",
              "@electron-toolkit/*",
              "fs",
              "path",
              "os",
              "child_process",
              "http",
              "https",
              "net",
              "tls",
              "crypto",
              "stream",
              "buffer",
              "process"
            ]
          }
        ]
      }
    }
  ]
}
