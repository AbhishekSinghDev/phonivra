{
  "name": "@phonivra/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25",
    "pnpm": ">=12.15.0 <13"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./hooks/use-audio-config": "./src/hooks/use-audio-config.tsx",
    "./hooks/use-audio-context": "./src/hooks/use-audio-context.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --config ../../.oxfmtrc.json --write .",
    "format:check": "oxfmt --config ../../.oxfmtrc.json --check ."
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "radix-ui": "^1.8.1",
    "sonner": "latest",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tailwindcss": "^4.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.22.1"
  }
}
