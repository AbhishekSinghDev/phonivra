{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".nvmrc", ".oxlintrc.json", ".oxfmtrc.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["out/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/types/**", "next-env.d.ts", "*.tsbuildinfo"]
    },
    "check": {
      "cache": false,
      "outputs": []
    },
    "phonivra#build": {
      "dependsOn": ["^build", "^typecheck", "@phonivra/engine#check"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["out/**"]
    },
    "phonivra#typecheck": {
      "dependsOn": ["^typecheck", "@phonivra/engine#check"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["*.tsbuildinfo"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DISPLAY",
        "WAYLAND_DISPLAY",
        "XAUTHORITY",
        "XDG_RUNTIME_DIR",
        "DBUS_SESSION_BUS_ADDRESS",
        "PHONIVRA_PYTHON"
      ]
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "outputs": []
    }
  }
}
