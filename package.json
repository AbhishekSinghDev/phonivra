{
  "name": "phonivra-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.0 <25",
    "pnpm": ">=12.15.0 <13"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:desktop": "turbo run dev --filter=phonivra",
    "dev:website": "turbo run dev --filter=@phonivra/website",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "ui:add": "pnpm --filter @phonivra/ui exec shadcn add",
    "preview": "pnpm --filter phonivra preview"
  },
  "devDependencies": {
    "oxlint": "^1.90.0",
    "oxfmt": "^0.75.0",
    "@shadcn/lint": "^0.2.3",
    "turbo": "^2.11.10"
  }
}
