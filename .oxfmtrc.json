{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": false,
  "trailingComma": "none",
  "printWidth": 100,
  "sortPackageJson": false,
  "ignorePatterns": [
    ".agents/**",
    "**/out/**",
    "**/dist/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/next-env.d.ts",
    "pnpm-lock.yaml"
  ]
}
